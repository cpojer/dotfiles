#!/usr/bin/env bash

set -euo pipefail

VSCODE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
source_path="$VSCODE_ROOT/User"
target_path="$HOME/Library/Application Support/Code/User"

mkdir -p "$(dirname "$target_path")"

if [ -L "$target_path" ]; then
  if [ "$(readlink "$target_path")" = "$source_path" ]; then
    echo "VS Code settings already linked."
    exit 0
  fi

  rm "$target_path"
elif [ -e "$target_path" ]; then
  backup_path="${target_path}.backup.$(date +%Y%m%d%H%M%S)"
  mv "$target_path" "$backup_path"
  echo "Moved existing VS Code User folder to $backup_path"
fi

ln -s "$source_path" "$target_path"
echo "Linked VS Code settings."
